<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The board class restores its one dependency, the standard GPIO
       package, from the public feed; the clear keeps any machine-level feed
       out, as the other package projects' configuration does. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
