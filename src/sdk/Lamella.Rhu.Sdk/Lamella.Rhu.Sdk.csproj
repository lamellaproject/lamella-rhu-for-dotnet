<Project Sdk="Microsoft.NET.Sdk">

  <!-- The SDK package: no build output; the Sdk folder and the staged
       frozen contents (the maps, the kernels, the tier objects, the
       runtime archives, the task assembly and their records) packed from
       the directory RhuStage names. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RhuSdkVersion Condition="'$(RhuSdkVersion)' == ''">1.0.0-alpha.1</RhuSdkVersion>
    <PackageId>Lamella.Rhu.Sdk</PackageId>
    <Version>$(RhuSdkVersion)</Version>
    <Authors>Lamella LLC</Authors>
    <Company>Lamella LLC</Company>
    <Copyright>Copyright (c) 2026 Lamella LLC</Copyright>
    <Description>Builds a .NET program into a Lamella RHU image for a microcontroller board</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/lamellaproject/lamella-rhu-for-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>First pre-release</PackageReleaseNotes>
    <PackageType>MSBuildSdk</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS2008;NU5100;NU5110;NU5111;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(RhuStage)' != ''">
    <None Include="$(RhuStage)/**" Pack="true" PackagePath="/" />
  </ItemGroup>

  <Target Name="RhuRequireStage" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(RhuStage)' == '' or !Exists('$(RhuStage)/Sdk/Sdk.targets')" Text="REFUSE: RhuStage must name the staged package contents" />
  </Target>

</Project>
