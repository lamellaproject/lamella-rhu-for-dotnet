<Project Sdk="Microsoft.NET.Sdk">

  <!-- The SDK package: no build output; the Sdk folder and the staged
       frozen contents (the maps, the kernels, the tier objects, the
       runtime archives, the task assembly and their records) packed from
       the directory RhuStage names. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RhuSdkVersion Condition="'$(RhuSdkVersion)' == ''">0.1.0-a</RhuSdkVersion>
    <PackageId>Lamella.Rhu.Sdk</PackageId>
    <Version>$(RhuSdkVersion)</Version>
    <Authors>Lamella LLC</Authors>
    <Company>Lamella LLC</Company>
    <Copyright>Copyright (c) 2026 Lamella LLC and the Lamella project authors</Copyright>
    <Description>The MSBuild SDK that builds a .NET program into a Lamella RHU image for a named board: the targets, the board table, the payload maps, the prebuilt kernels, the frozen host tier and the runtime's native archives at the tested build.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageType>MSBuildSdk</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS2008;NU5100;NU5110;NU5111;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(RhuStage)' != ''">
    <None Include="$(RhuStage)/**" Pack="true" PackagePath="/" />
  </ItemGroup>

  <Target Name="RhuRequireStage" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(RhuStage)' == '' or !Exists('$(RhuStage)/Sdk/Sdk.targets')" Text="REFUSE: RhuStage must name the staged package contents" />
  </Target>

</Project>
