<Project>

  <!-- The board table: one row per target name, spelled maker-product.
       A row names the processor class, the payload map, the prebuilt
       kernel, the runtime archive set, the build-attributes donor, the
       tier objects the image links in the link's order (the shim's five
       link objects, the P/Invoke-facing surface object, the GPIO API
       object, the bus and PWM device objects, the serial device object
       and the serial layer's object, the three collector row objects,
       the C-library closure),
       the row's own objects among them (BoardObjects: its shim core and
       system-call objects and its heap and collect rows, four names from
       the Objects list, which ride in the row's board package where the
       rest ride in the processor class's runtime package; the link keeps
       the Objects order and takes each from the package that carries it),
       the thread stack facts (the kernel's stack pool for the row, the
       default managed stack and its clamp, in bytes: copies of the
       kernel's and the hosting layer's constants that the verification
       chain checks against the sources), the emulator machine (empty
       for a physical board), the image base, and the two streams' default
       channels with the row's legal channel set (LogChannel, ConsoleChannel,
       Channels: copies of the facts file's channels row, which the chain
       checks too). A row that carries an
       external RAM range names beside its default kernel (init at boot)
       the two archives built for the lazy init modes, which the project's
       RhuExternalRamInit value picks; the other rows carry none. Such a
       row also names a second payload map (MapInternal), which keeps the
       hosted runtime's rehydrated type data and the managed heap's window
       in the chip's own RAM, picked by the project's RhuManagedMemory
       value in place of the row's map. A row whose board carries a
       memory-mapped external flash names a third payload map
       (MapExternalFlash), which places the hosted program's managed code,
       read-only data and unwind tables in that flash, executed in place,
       picked by the project's RhuProgramMemory value. A row says where the
       library the standard analog classes express a voltage in fits
       (AnalogVoltageFits): internal-flash when the chip's own flash holds
       it, external-flash when the board's external flash alone does; a
       row without the attribute does not hold it, and the SDK leaves the
       analog voltage switch false there. Every
       path is relative to the root of the package that carries it. -->
  <ItemGroup>
    <LamellaTargetBoardRow Include="arm-mps2-an500"
                 Class="cortex-m7"
                 Map="maps/payload-mps2-an500.x"
                 MapInternal="maps/payload-mps2-an500-internal.x"
                 Kernel="kernels/arm-mps2-an500/librhu_kernel.a"
                 KernelRamInitFirstUse="kernels/arm-mps2-an500/ram-init-first-use/librhu_kernel.a"
                 KernelRamInitBackground="kernels/arm-mps2-an500/ram-init-background/librhu_kernel.a"
                 Archives="archives/cortex-m7"
                 Donor="tier/cortex-m7/attr-donor-v7em.bin"
                 Objects="tier/cortex-m7/shim-core.o tier/cortex-m7/shim-sysnative.o tier/cortex-m7/shim-libc-glue.o tier/cortex-m7/shim-stdio-sym.o tier/cortex-m7/shim-host.o tier/cortex-m7/shim-pal-surface.o tier/cortex-m7/shim-gpiod.o tier/cortex-m7/shim-busdev.o tier/cortex-m7/shim-pwmfs.o tier/cortex-m7/shim-iiofs.o tier/cortex-m7/shim-ttydev.o tier/cortex-m7/shim-ports-native.o tier/cortex-m7/skel-row.o tier/cortex-m7/heap-row.o tier/cortex-m7/collect-row.o tier/cortex-m7/rt-libc.o"
                 BoardObjects="tier/cortex-m7/shim-core.o tier/cortex-m7/shim-sysnative.o tier/cortex-m7/heap-row.o tier/cortex-m7/collect-row.o"
                 StackPool="131072"
                 StackDefault="16384"
                 StackClamp="24576"
                 LogChannel="uart0"
                 ConsoleChannel="uart0"
                 Channels="uart0 uart1 memory off"
                 Machine="mps2-an500"
                 Base="0x00000000" />
