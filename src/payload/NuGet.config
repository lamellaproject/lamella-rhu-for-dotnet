<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The one package source. The clear keeps any machine-level feed out of
       the restore, so what lands in the package cache came from here. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
