<Project Sdk="Lamella.Rhu.Sdk">

  <!-- The gate's second program: the board class, built by name. The
       SDK generates the row's facts into this program because it references
       Lamella.Hardware; the parity leg publishes it and boots its image. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>tbhello</AssemblyName>
    <RootNamespace>Rhu.Hosted</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LamellaHardwareVersion Condition="'$(LamellaHardwareVersion)' == ''">1.0.0-alpha.1</LamellaHardwareVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lamella.Hardware" Version="$(LamellaHardwareVersion)" />
  </ItemGroup>

</Project>
