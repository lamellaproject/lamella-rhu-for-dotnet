<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Two package sources: the public feed for the runtime packs and the
       local feed the RHU SDK is packed into. The clear keeps any
       machine-level feed out of the restore, so what lands in the package
       cache came from one of these. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="rhu-local" value="../../kernel/target/sdk-feed" />
  </packageSources>
</configuration>
